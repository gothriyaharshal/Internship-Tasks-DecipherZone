class Boxing
{
    //making an producer method our there
    Integer temp = null;
    Boolean flag = false;

    synchronized void producing(int value) {
        try {
            while (temp != null) {
                wait();
            }
            temp = value;
            flag = true;
            System.out.println("Producer Producing this " + temp);
            notify();
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }
    }



    synchronized void consuming() throws InterruptedException {
        try {
            while (temp == null) {
                wait();
            }
            System.out.println("Consumer consuming this " + temp);
            temp = null;
            flag = false;
            notify();
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }
    }

}

